apiVersion: apps/v1
kind: Deployment
metadata:
  name: web-aula9
  namespace: aula9
spec:
  replicas: 2
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels: {app: web-aula9}
  template:
    metadata:
      labels: {app: web-aula9}
>     spec:
      containers:
      - name: web
        image: nginx:alpine
        command: ['/bin/sh', '-c']
        args:
        - 'echo "<h1>Versao $VERSAO</h1>" > /usr/share/nginx/html/index.html; exec nginx -g "daemon off;"'
        env:
        - name: VERSAO
          value: '1'
        ports:
        - containerPort: 80
        readinessProbe:
          httpGet: {path: /, port: 80}
          periodSeconds: 3
---
apiVersion: v1
kind: Service
metadata: {name: web-aula9, namespace: aula9}
spec:
  selector: {app: web-aula9}
  ports: [{port: 80, targetPort: 80}]
EOF


